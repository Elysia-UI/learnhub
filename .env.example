# 浏览器使用 /api，经 Vite 转发；以下 DB_* 仅由服务端读取，禁止加 VITE_ 前缀。
API_PORT=3001
API_HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3001,http://127.0.0.1:4173
# Windows 本机可省略 DB_*，使用 .local/database.dpapi 中的加密配置。
# Linux/正式部署请通过服务端环境设置以下项目专用账号信息。
DB_HOST=
DB_PORT=3306
DB_NAME=learnhub
DB_USER=learnhub_app
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
STORAGE_DIR=.storage
# 首次初始化可设置；未设置时自动生成随机强密码并存入 Windows DPAPI。
ADMIN_EMAIL=admin@learnhub.example.invalid
ADMIN_PASSWORD=
# AI 尚未接入，密钥不得进入前端。
# 正式部署设 NODE_ENV=production，并使用 HTTPS；本机开发不设置。
# NODE_ENV=production
# Windows DPAPI 辅助脚本所用 Python，可根据实际机器覆盖默认路径。
# DB_PYTHON=C:/path/to/python.exe
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
