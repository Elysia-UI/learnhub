{
  "name": "learnhub-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run && node --test --test-concurrency=1 server/tests/api.test.mjs",
    "format": "prettier --write src server scripts tests docs *.json *.ts *.md",
    "start": "node scripts/start.mjs",
    "test:api": "node --test --test-concurrency=1 server/tests/api.test.mjs",
    "accounts:show": "node scripts/show-accounts.mjs",
    "db:provision": "node scripts/provision.mjs",
    "db:seed": "node server/seed.mjs",
    "start:production": "node server/index.mjs",
    "dev:api": "node --watch server/index.mjs",
    "test:unit": "vitest run",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node server/migrate.mjs",
    "serve:api": "node server/index.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "db:enrich": "node server/enrich-demo.mjs",
    "demo:media": "node scripts/fetch-demo-media.mjs",
    "demo:verify": "node scripts/verify-community.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.7",
    "dotenv": "^18.0.9",
    "echarts": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^16.4.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
