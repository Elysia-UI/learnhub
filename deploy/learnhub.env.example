# Store the real file at /etc/learnhub/learnhub.env, owned by root, mode 0600.
# systemd EnvironmentFile syntax: quote values and escape embedded quotes/backslashes.
# Never copy this file, the real secrets file or .local to the public dist folder.
APP_ORIGINS=https://__PUBLIC_HOST__
TRUST_PROXY=loopback
STORAGE_DIR=/srv/learnhub-data/files
DB_HOST=database.example.invalid
DB_PORT=3306
DB_NAME=learnhub
DB_USER=learnhub_app
DB_PASSWORD="replace-on-server"
DB_SSL=true
DB_SSL_CA=/etc/learnhub/mysql-ca.pem
AI_BASE_URL=https://your-provider.example.invalid/v1
AI_API_KEY="replace-on-server"
AI_MODEL=replace-with-provider-model
